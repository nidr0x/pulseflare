{
  "name": "pulseflare",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @pulseflare/web && npx tsc -b tsconfig.json --force --pretty false",
    "test": "npm run test --workspaces && node --test .github/scripts/resolve-cloudflare-resources.test.mjs .github/scripts/render-deploy-wrangler-config.test.mjs",
    "lint": "npm run lint --workspaces",
    "dev:web": "npm run dev --workspace @pulseflare/web",
    "dev:worker": "npm run dev --workspace @pulseflare/worker"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^7",
    "wrangler": "^4.122.0"
  }
}
