{
  "files": [],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "references": [
    { "path": "./apps/worker" },
    { "path": "./apps/web" },
    { "path": "./packages/core" },
    { "path": "./packages/schema" },
    { "path": "./config" }
  ]
}
